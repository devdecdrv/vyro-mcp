{
  "_comment": "Paste the 'mcpServers' block into your Claude Desktop config.json",
  "_config_location": {
    "linux":   "~/.config/Claude/claude_desktop_config.json",
    "mac":     "~/Library/Application Support/Claude/claude_desktop_config.json",
    "windows": "%APPDATA%\\Claude\\claude_desktop_config.json"
  },
  "mcpServers": {
    "vyro-mcp": {
      "command": "sudo",
      "args": [
        "python3",
        "/FULL/PATH/TO/vyro-mcp/server.py"
      ],
      "env": {
        "DISPLAY": ":0"
      }
    }
  }
}
